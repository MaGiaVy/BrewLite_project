export function formatVnd(amount: number): string {
  return `${new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 0 }).format(amount)}đ`;
}

export function normalizeSearch(value: string): string {
  return value.toLocaleLowerCase('vi-VN').normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').trim();
}

export function getProductImage(imageUrl: string): string {
  if (!imageUrl) return '/images/coffee-placeholder.svg';
  if (imageUrl.startsWith('/') && !imageUrl.startsWith('//')) {
    // Ảnh demo được lưu trong public/images.
    if (imageUrl.startsWith('/images/')) return imageUrl;
    // Với ảnh tương đối từ Backend, ghép với URL máy chủ.
    try {
      return new URL(imageUrl, process.env.NEXT_PUBLIC_API_URL || 'http://localhost:3001').toString();
    } catch { return '/images/coffee-placeholder.svg'; }
  }
  if (/^https?:\/\//i.test(imageUrl)) return imageUrl;
  return '/images/coffee-placeholder.svg';
}

