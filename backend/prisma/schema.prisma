// Prisma schema file - BrewLite Project
// PostgreSQL 16 + Prisma ORM v6.19.3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. NGƯỜI DÙNG (User)
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]

  @@map("users")
}

// 2. SẢN PHẨM (Product)
model Product {
  id          String   @id @default(uuid())
  name        String
  category    String   // COFFEE_VN, ESPRESSO, TEA
  price       Int      // Giá gốc size S (VNĐ)
  stock       Int      @default(0)
  imageUrl    String
  description String
  version     Int      @default(0) // Optimistic Locking Version
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
  recipes     ProductRecipe[]

  @@map("products")
}

// 2.1. NGUYÊN VẬT LIỆU (Ingredient - BOM Recipe)
model Ingredient {
  id        String   @id @default(uuid())
  name      String   @unique
  stock     Int      @default(0) // Số lượng tồn kho (g, ml, cái)
  unit      String   // g, ml, cái
  version   Int      @default(0) // Optimistic Locking Version
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes   ProductRecipe[]
  toppings  Topping[]

  @@map("ingredients")
}

// 2.2. ĐỊNH LƯỢNG CÔNG THỨC PHA CHẾ (ProductRecipe - BOM)
model ProductRecipe {
  id           String     @id @default(uuid())
  productId    String
  ingredientId String
  amount       Int        // Định lượng chuẩn cho Size S (g, ml, cái)

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@map("product_recipes")
}

// 3. TOPPING DÙNG CHUNG
model Topping {
  id               String   @id @default(uuid())
  name             String
  price            Int      // Giá topping (VNĐ)
  isAvailable      Boolean  @default(true)
  ingredientId     String?
  amountPerPortion Int      @default(30) // Định lượng mỗi phần (g hoặc ml)

  ingredient        Ingredient?        @relation(fields: [ingredientId], references: [id])
  orderItemToppings OrderItemTopping[]

  @@map("toppings")
}

// 4. MÃ GIẢM GIÁ (Voucher)
enum DiscountType {
  PERCENT
  FIXED
}

model Voucher {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  minOrderValue Int          @default(0)
  maxDiscount   Int          @default(0)
  usageLimit    Int          @default(100)
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  orders        Order[]

  @@map("vouchers")
}

// 5. ĐƠN HÀNG (Order)
enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  voucherId      String?
  status         OrderStatus @default(PENDING)
  total          Int
  discountAmount Int         @default(0)
  finalTotal     Int
  paymentMethod  String?     // WALLET, CARD
  idempotencyKey String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id])
  voucher        Voucher?    @relation(fields: [voucherId], references: [id])
  items          OrderItem[]
  payments       Payment[]

  @@unique([userId, idempotencyKey])
  @@map("orders")
}

// 6. CHI TIẾT DÒNG ĐƠN HÀNG (OrderItem)
model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  size            String   // S, M, L
  ice             String?  // 100% Đá, 70% Đá...
  sugar           String?  // Chuẩn Ngọt, 70% Đường...
  quantity        Int
  priceAtPurchase Int      // Snapshot giá ly cơ sở + phụ thu size
  lineTotal       Int      // Snapshot tổng dòng

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
  toppings        OrderItemTopping[]

  @@map("order_items")
}

// 7. SNAPSHOT TOPPING TRONG DÒNG ĐƠN HÀNG
model OrderItemTopping {
  id           String    @id @default(uuid())
  orderItemId  String
  toppingId    String
  toppingName  String    // Snapshot tên
  toppingPrice Int       // Snapshot giá

  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  topping      Topping   @relation(fields: [toppingId], references: [id])

  @@map("order_item_toppings")
}

// 8. GIAO DỊCH THANH TOÁN (Payment)
enum PaymentStatus {
  SUCCESS
  FAILURE
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  idempotencyKey String        @unique
  amount         Int
  method         String        // WALLET, CARD
  status         PaymentStatus
  createdAt      DateTime      @default(now())

  order          Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}
