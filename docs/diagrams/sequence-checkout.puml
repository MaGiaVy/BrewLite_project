@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam sequence {
  LifeLineBorderColor #000000
  LifeLineBorderThickness 1.5
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #000000
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #000000
  ActorBackgroundColor #FFFFFF
  DatabaseBorderColor #000000
  DatabaseBackgroundColor #FFFFFF
  GroupBorderColor #000000
  GroupBackgroundColor #FFFFFF
  GroupHeaderFontStyle bold
  DividerBackgroundColor #FFFFFF
  DividerBorderColor #000000
}

title Biểu đồ Tuần tự Luồng Đặt hàng & Thanh toán (BrewLite Checkout)

actor "Customer" as Customer
participant "Next.js Web" as Web
participant "NestJS API" as API
database "PostgreSQL" as DB
participant "ZaloPay / Mock Payment" as Gateway

activate Customer
Customer -> Web : Nhấn "Đặt hàng" trên /checkout
activate Web
Web -> Web : Kiểm tra JWT (chưa có -> /auth/login)

== Phase 1: Tạo đơn & Khóa kho BOM ==

Web -> API : POST /orders (Bearer JWT, Idempotency-Key)
activate API
API -> DB : Transaction: check < 5 đơn chờ, check Recipe bắt buộc,\ntính giá (0% VAT), check Voucher (1 lần/userId với mã công khai)\n& trừ kho BOM (Optimistic Lock version + 1)
activate DB

alt Lỗi kho / công thức (400 / 409)
  DB --> API : Rollback transaction
  API --> Web : 400 Bad Request / 409 Conflict
  Web --> Customer : Hiển thị lỗi để chỉnh giỏ hàng
else Giữ kho thành công
  DB --> API : Tạo Order (PENDING, TTL 5 phút (300s)) & InventoryLog
  deactivate DB
  API --> Web : 201 Created (orderId, totalAmount)
  deactivate API
  Web --> Customer : Hiển thị màn hình chờ thanh toán (TTL 5 phút (300s))
end
deactivate Web

== Phase 2: Thanh toán (ZaloPay / Mock) ==

Customer -> Web : Chọn phương thức thanh toán
activate Web

alt ZaloPay Sandbox (/gateway/zalopay)
  Web -> API : POST /payments/zalopay/create
  activate API
  API -> Gateway : v2/create (HMAC Key1)
  activate Gateway
  Gateway --> API : orderUrl / appTransId (hiện QR PENDING)
  deactivate Gateway
  API --> Web : Điều hướng /gateway/zalopay (QR 5 phút)
  deactivate API

  alt Khách bấm "Hủy đơn & Hoàn kho" khi đang hiện QR (PENDING)
    Customer -> Web : Bấm "Hủy đơn & Hoàn kho"
    Web -> API : PATCH /orders/:id/status\n{ status: "CANCELLED" }
    activate API
    API -> DB : Order -> CANCELLED &\nhoàn kho BOM + Voucher
    activate DB
    DB --> API : Commit
    deactivate DB
    API --> Web : 200 CANCELLED
    deactivate API
    Web --> Customer : Thông báo đã hủy & hoàn kho
  else Xác nhận thanh toán ZaloPay
    Gateway --> API : IPN POST /payments/zalopay/callback (HMAC Key2)\nhoặc POST /payments/zalopay/confirm (Sandbox)
    activate API
    API -> DB : CAS Order -> PAID & tạo Payment (SUCCESS)
    activate DB
    DB --> API : Commit
    deactivate DB
    API --> Web : 200 PAID (Web poll GET /orders/:id)
    deactivate API
    Web --> Customer : Xóa giỏ hàng & chuyển sang /orders/:id
  end
else Mock Payment (POST /payments)
  Web -> API : POST /payments (Idempotency-Key)
  activate API
  API -> Gateway : Xử lý thanh toán mô phỏng
  activate Gateway
  Gateway --> API : Kết quả SUCCESS / FAILURE
  deactivate Gateway

  alt Thành công
    API -> DB : CAS Order -> PAID & tạo Payment (SUCCESS)
    activate DB
    DB --> API : Commit
    deactivate DB
    API --> Web : 201 PAID
    deactivate API
    Web --> Customer : Xóa giỏ hàng & chuyển sang /orders/:id
  else Thất bại (chỉ phát sinh với Mock Payment)
    API -> DB : Cập nhật Order -> PAYMENT_FAILED\n(giữ kho BOM trong 5 phút (300s) TTL)
    activate DB
    DB --> API : Commit
    deactivate DB
    API --> Web : 201 PAYMENT_FAILED
    deactivate API
    Web --> Customer : Hiển thị "Thử lại" hoặc "Hủy đơn" trên /checkout
    opt Khách bấm "Hủy đơn" trên /checkout
      Customer -> Web : Bấm "Hủy đơn"
      Web -> API : PATCH /orders/:id/status\n{ status: "CANCELLED" }
      activate API
      API -> DB : Order -> CANCELLED &\nhoàn kho BOM + Voucher
      activate DB
      DB --> API : Commit
      deactivate DB
      API --> Web : 200 CANCELLED
      deactivate API
    end
  end
end
deactivate Web

== Theo dõi tiến độ đơn hàng ==

activate Web
loop Polling mỗi 5 giây cho đến khi COMPLETED / CANCELLED
  Web -> API : GET /orders/:id
  activate API
  API -> DB : Truy vấn trạng thái đơn
  activate DB
  DB --> API : Trả trạng thái đơn
  deactivate DB
  API --> Web : PAID -> PREPARING -> READY -> COMPLETED
  deactivate API
end
Web --> Customer : Hiển thị hoàn tất & nhận đồ uống
deactivate Web
deactivate Customer
note right of API
  Điểm Hạt Vàng (+floor(total / 1.000đ))
  chỉ cộng khi KDS chuyển READY -> COMPLETED
  (hủy đơn PAID chỉ hoàn BOM & Voucher).
end note

@enduml
