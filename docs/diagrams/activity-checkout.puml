@startuml
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam shadowing false
skinparam monochrome true
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle hline

skinparam activity {
    BorderColor black
    BackgroundColor white
    ArrowColor black
}
skinparam swimlane {
    BorderColor black
    TitleFontColor black
}

' Thành viên thực hiện: Mã Gia Vỹ (Task 2.1 - Activity Diagram)
title SÔ ĐÔ HOAT ĐÔNG: LUÔNG ĐÂT HÀNG & THANH TOÁN END-TO-END\n(Xem Menu -> Tùy biên Size/Topping -> Giỏ hàng -> PENDING -> ZaloPay -> KDS -> Nhận món)

|#White|Khách hàng (Customer)|
|#White|Giao diện Web (Next.js)|
|#White|Backend API (NestJS)|
|#White|Cổng thanh toán (ZaloPay)|
|#White|Cơ sở dữ liệu (PostgreSQL)|

' =========================================================================
' 1. DUYÊT THỰC ĐƠN
' =========================================================================
|Khách hàng (Customer)|
start
:Truy cập trang Thực đơn (/menu);

|Giao diện Web (Next.js)|
:Hiện Skeleton loader;\nGửi GET /products;

|Backend API (NestJS)|
:Tiếp nhận yêu cầu;\nTruy vấn danh sách sản phẩm & tồn kho;

|Cơ sở dữ liệu (PostgreSQL)|
:Trả về danh sách Product\nkèm cấu hình định giá & BOM;

|Giao diện Web (Next.js)|
:Hiển thị card món theo tab\n(Cà phê phin, Espresso, Trà, Bánh);

' =========================================================================
' 2. CHON MÓN — if/else KHÔNG switch lane, dùng detach cho nhánh chết
' =========================================================================
|Khách hàng (Customer)|
:Chọn xem 1 sản phẩm cụ thể;

|Giao diện Web (Next.js)|
if (Sản phẩm còn hàng?) then ([Hết hàng / Sold Out])
    :Hiển thị badge "Hết hàng";\nLàm mờ card & khóa nút chọn món;
    detach
else ([Còn hàng sẵn sàng])
    :Mở ProductDetailModal;\nHiện Size S/M/L, Topping, Đá/Đường;
endif

|Khách hàng (Customer)|
:Chọn kích cỡ (Size S, M, L);\nTích Topping (Kem muối biển / Thạch / Trân châu);\nTùy chỉnh Đá (0–100%) và Đường (0–100%);

|Giao diện Web (Next.js)|
:Tính giá real-time:\n(basePrice + sizeUpcharge + sum(toppingPrice)) x quantity;\nCập nhật giá trên nút "Thêm vào giỏ";

|Khách hàng (Customer)|
:Bấm nút "Thêm vào giỏ hàng";

|Giao diện Web (Next.js)|
if (Composite key đã có trong giỏ?) then ([Đã có cùng tùy chọn])
    :Cộng dồn: quantity += 1;
else ([Chưa có trong giỏ])
    :Thêm dòng món mới vào Giỏ;
endif
:Lưu giỏ Zustand & localStorage;\nCập nhật badge số lượng trên Header;

' =========================================================================
' 3. QUẢN LÝ GIỎ HÀNG
' =========================================================================
|Khách hàng (Customer)|
:Mở trang Giỏ hàng (/cart);\nKiểm tra, chỉnh số lượng (+/-)\nhoặc nhập mã Voucher giảm giá;

|Giao diện Web (Next.js)|
:Tự động tính lại Tạm tính & Tổng thanh toán;

|Khách hàng (Customer)|
:Nhấn "Tiến hành đặt hàng";

' =========================================================================
' 4. AUTH CHECK — if/else KHÔNG switch lane, mô tả cross-lane bằng text
' =========================================================================
|Giao diện Web (Next.js)|
:Kiểm tra JWT trong AuthStore;
if (Đã đăng nhập?) then ([Chưa đăng nhập / Hết hạn])
    :Lưu redirect=/checkout;\nChuyển sang /auth/login;\n[Khách nhập email & mật khẩu]\n[Backend xác thực, cấp JWT 7 ngày]\nTự động quay lại /checkout\n(giỏ hàng được bảo lưu);
else ([Đã có JWT hợp lệ])
    :Chuyển thẳng sang /checkout;
endif

|Khách hàng (Customer)|
:Chọn phương thức thanh toán;\nNhấn "Xác nhận & Thanh toán";

|Giao diện Web (Next.js)|
:Sinh Idempotency-Key (UUIDv4);\nKhóa nút chống gửi trùng;\nGửi POST /orders kèm JWT;

' =========================================================================
' 5. ĐẶT ĐƠN — if/else KHÔNG switch lane
' =========================================================================
|Backend API (NestJS)|
:Transaction Pha 1;\nSELECT User FOR UPDATE;\nKiểm tra <= 5 đơn PENDING;

|Cơ sở dữ liệu (PostgreSQL)|
:Kiểm tra tồn kho BOM & version;

|Backend API (NestJS)|
if (Đủ kho & version hợp lệ?) then ([Thiếu kho / Conflict 409])
    :Rollback Pha 1;\nTrả HTTP 409;\n[UI: mở khóa nút, Toast đỏ,\ngiữ giỏ để khách chọn lại];
    stop
else ([Đủ tồn kho])
    :Trừ kho tạm (giữ chỗ BOM);\nversion += 1;\nTạo Order PENDING;\nCommit Pha 1;\nĐếm ngược 15 phút;\nGửi tạo giao dịch ZaloPay;
endif

' =========================================================================
' 6. THANH TOÁN ZALOPAY
' =========================================================================
|Cổng thanh toán (ZaloPay)|
:Tạo mã giao dịch & QR Code;

|Giao diện Web (Next.js)|
:Hiện QR + đếm ngược 15 phút;\nPolling GET /orders/:id mỗi 3 giây;

|Khách hàng (Customer)|
:Mở app quét QR hoặc xác nhận thẻ;

|Cổng thanh toán (ZaloPay)|
:Xử lý đối soát & trừ tiền;

' =========================================================================
' 7. KẾT QUẢ THANH TOÁN — if/else KHÔNG switch lane
' =========================================================================
|Backend API (NestJS)|
if (Kết quả thanh toán?) then ([Thành công])
    :IPN Webhook (xác thực HMAC);\nTransaction Pha 2: PENDING→PAID;\nTrừ kho BOM chính thức;\nTạo Payment SUCCESS;\nCộng Hạt Vàng (1.000đ = 1pt);\nCommit Pha 2; return_code=1;\n[UI: polling PAID, xóa giỏ, /orders/:id];
else ([Thất bại])
    :PAYMENT_FAILED;\nGiữ kho BOM 15 phút;\n[UI: hiện lỗi, sinh Key mới];
    |Giao diện Web (Next.js)|
    if (Khách xử lý tiếp?) then ([Thử lại])
        :Gửi lại yêu cầu thanh toán;
        stop
    else ([Hủy / Hết 15 phút])
        :Hoàn kho BOM;\nCập nhật CANCELLED;\n[Thông báo đơn bị hủy];
        stop
    endif
endif

' =========================================================================
' 8. THEO DÕI ĐƠN & NHẬN MÓN
' =========================================================================
|Khách hàng (Customer)|
:Xem mã nhận nước & thanh tiến trình 5 nấc;

|Backend API (NestJS)|
:KDS hiện đơn;\nBarista bấm "Bắt đầu" → PAID→PREPARING;

|Giao diện Web (Next.js)|
:Thanh tiến trình: ĐANG PHA CHẾ;

|Backend API (NestJS)|
:Barista bấm "Xong" → PREPARING→READY;

|Giao diện Web (Next.js)|
:Trạng thái: SẴN SÀNG;\nPhát thông báo tới Quầy Express;

|Khách hàng (Customer)|
:Đến Quầy, đọc mã & nhận món;

|Backend API (NestJS)|
:Ghi nhận COMPLETED;

|Khách hàng (Customer)|
:Hoàn tất phiên mua sắm;
stop

@enduml
