@startuml
left to right direction
skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam roundcorner 10

' Tối giản chuẩn UML, không màu mè
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actor {
    BorderColor black
    BackgroundColor white
}
skinparam usecase {
    BorderColor black
    BackgroundColor white
    ArrowColor black
}
skinparam rectangle {
    BorderColor black
    BackgroundColor white
}

title SƠ ĐỒ USE CASE TỔNG QUÁT HỆ THỐNG BREWLITE\n(Nền tảng Đặt đồ uống & Thanh toán không tiền mặt)

' ==========================================
' ACTORS BÊN TRÁI (Khách hàng)
' ==========================================
actor "Khách hàng" as Customer

' ==========================================
' SYSTEM BOUNDARY
' ==========================================
rectangle "Hệ thống BrewLite (Next.js & NestJS)" {

    ' --- Nhóm Xác thực & Tài khoản ---
    usecase "Đăng ký tài khoản" as UC_Register
    usecase "Đăng nhập hệ thống" as UC_Login
    usecase "Xác thực phân quyền (RBAC)" as UC_RBAC

    ' --- Nhóm Khách hàng (Menu, Giỏ hàng, Đặt đơn) ---
    usecase "Xem thực đơn & tìm kiếm món" as UC_Menu
    usecase "Xem chi tiết món & chọn Size, Topping" as UC_Detail
    usecase "Quản lý giỏ hàng" as UC_Cart
    usecase "Đặt hàng & Thanh toán" as UC_Checkout
    usecase "Áp dụng mã giảm giá (Voucher)" as UC_Voucher
    usecase "Tích lũy & dùng điểm thưởng" as UC_Loyalty
    usecase "Xử lý thanh toán trực tuyến" as UC_Payment
    usecase "Theo dõi tiến độ đơn thời gian thực" as UC_Track
    usecase "Xem lịch sử đơn hàng" as UC_History
    usecase "Hủy đơn hàng" as UC_Cancel

    ' --- Nhóm Quầy pha chế (Staff KDS) ---
    usecase "Tiếp nhận đơn hàng quầy pha chế (KDS)" as UC_StaffView
    usecase "Cập nhật trạng thái pha chế" as UC_StaffUpdate

    ' --- Nhóm Quản trị (Admin) ---
    usecase "Quản lý danh mục & thực đơn món" as UC_AdminMenu
    usecase "Quản lý định mức công thức (BOM)" as UC_AdminBOM
    usecase "Quản lý & cảnh báo kho nguyên liệu" as UC_AdminInventory
    usecase "Quản lý mã giảm giá (Voucher)" as UC_AdminVoucher
    usecase "Xem báo cáo thống kê & doanh thu" as UC_AdminReport

    ' Quan hệ Include & Extend
    UC_Login ..> UC_RBAC : <<include>>
    UC_Checkout ..> UC_Payment : <<include>>
    UC_Checkout ..> UC_Loyalty : <<include>>
    UC_Voucher ..> UC_Checkout : <<extend>>
}

' ==========================================
' ACTORS BÊN PHẢI (Nhân viên, Quản trị viên, Cổng thanh toán)
' ==========================================
actor "Nhân viên (Barista)" as Staff
actor "Quản trị viên (Admin)" as Admin
actor "Cổng thanh toán (ZaloPay)" as PaymentGateway

' ==========================================
' KẾT NỐI KHÁCH HÀNG (BÊN TRÁI)
' ==========================================
Customer --> UC_Register
Customer --> UC_Login
Customer --> UC_Menu
Customer --> UC_Detail
Customer --> UC_Cart
Customer --> UC_Checkout
Customer --> UC_Track
Customer --> UC_History
Customer --> UC_Cancel

' ==========================================
' KẾT NỐI NHÂN VIÊN (BÊN PHẢI)
' ==========================================
Staff --> UC_Login
Staff --> UC_StaffView
Staff --> UC_StaffUpdate

' ==========================================
' KẾT NỐI QUẢN TRỊ VIÊN (BÊN PHẢI)
' ==========================================
Admin --> UC_Login
Admin --> UC_AdminMenu
Admin --> UC_AdminBOM
Admin --> UC_AdminInventory
Admin --> UC_AdminVoucher
Admin --> UC_AdminReport

' ==========================================
' KẾT NỐI CỔNG THANH TOÁN (BÊN PHẢI)
' ==========================================
UC_Payment --> PaymentGateway

@enduml
