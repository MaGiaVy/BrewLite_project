@startuml
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12

title **SƠ ĐỒ USE-CASE TỔNG QUÁT HỆ THỐNG BREWLITE**\n(BrewLite 100% Cashless Specialty Coffee Roastery Platform)

' ==============================================================================
' ACTORS
' ==============================================================================
actor "Khách vãng lai\n(Guest)" as Guest #E8F4FD
actor "Khách hàng thành viên\n(Customer)" as Customer #D1E8FF
actor "Nhân viên Quầy bar\n(Barista / Staff)" as Staff #FFF3E0
actor "Quản lý Cửa hàng\n(Admin)" as Admin #F8CECC
actor "Cổng thanh toán\n(ZaloPay / VietQR)" as Gateway <<External>> #E1D5E7

Guest <|-- Customer : Kế thừa

' ==============================================================================
' SYSTEM BOUNDARY
' ==============================================================================
rectangle "HỆ THỐNG BREWLITE (Next.js PWA & NestJS API)" {
    
    package "Phân hệ Xác thực & Phân quyền (RBAC)" {
        usecase "UC10: Đăng ký tài khoản khách hàng\n(Register Customer)" as UC_Register
        usecase "UC11: Đăng nhập & Xác thực JWT\n(Login & Token Generation)" as UC_Login
        usecase "UC11a: Điều hướng Phân quyền vai trò\n(RBAC: Admin / Staff / Customer)" as UC_RBAC_Routing #FFF9C4
    }

    package "Phân hệ Thực đơn & Mua hàng" {
        usecase "UC01: Khám phá Menu & Tìm kiếm món" as UC_Menu
        usecase "UC02: Tùy biến món (Size, Topping, Đá/Đường)" as UC_Customize
        usecase "UC03: Quản lý giỏ hàng (Cart Store)" as UC_Cart
        usecase "UC04: Đặt và thanh toán đơn hàng" as UC_Checkout #FFE0B2
        usecase "UC05: Áp dụng mã giảm giá (Voucher)" as UC_Voucher
        usecase "UC06: Tích lũy & Dùng điểm thưởng (Loyalty)" as UC_Loyalty
        usecase "UC07: Theo dõi tiến độ đơn hàng (Realtime)" as UC_Track
        usecase "UC08: Xem lịch sử đơn hàng" as UC_History
        usecase "UC09: Hủy đơn hàng (Trước khi pha chế)" as UC_Cancel
    }

    package "Phân hệ Vận hành Quầy Bar (KDS)" {
        usecase "UC12: Tiếp nhận đơn đã thanh toán (KDS)" as UC_KDS_View
        usecase "UC13: Cập nhật tiến trình pha chế\n(PREPARING -> READY -> COMPLETED)" as UC_KDS_Update
    }

    package "Phân hệ Quản trị (Admin Portal)" {
        usecase "UC14: Quản lý Danh mục & Menu (CRUD món)" as UC_Admin_Menu
        usecase "UC15: Quản lý Kho nguyên liệu & Công thức BOM" as UC_Admin_BOM
        usecase "UC16: Quản lý Mã khuyến mãi (Voucher)" as UC_Admin_Voucher
        usecase "UC17: Xem báo cáo thống kê & Doanh thu" as UC_Admin_Report
    }

    usecase "Xác thực danh tính (JwtAuthGuard)" as UC_Auth_Check #E0F2F1
    usecase "Kiểm tra quyền vai trò (RolesGuard)" as UC_Roles_Check #E0F2F1
    usecase "Trừ kho nguyên liệu (Optimistic Lock & BOM)" as UC_Deduct_Stock #E0F2F1
    usecase "Xử lý giao dịch qua Cổng thanh toán (ZaloPay)" as UC_Process_Payment #E0F2F1
}

' ==============================================================================
' RELATIONSHIPS & ASSOCIATIONS
' ==============================================================================

' Guest & Customer
Guest --> UC_Menu
Guest --> UC_Customize
Guest --> UC_Cart
Guest --> UC_Register
Guest --> UC_Login

Customer --> UC_Checkout
Customer --> UC_Loyalty
Customer --> UC_Track
Customer --> UC_History
Customer --> UC_Cancel

' Staff
Staff --> UC_Login
Staff --> UC_KDS_View
Staff --> UC_KDS_Update
Staff ..> UC_Roles_Check : <<include>>

' Admin
Admin --> UC_Login
Admin --> UC_Admin_Menu
Admin --> UC_Admin_BOM
Admin --> UC_Admin_Voucher
Admin --> UC_Admin_Report
Admin ..> UC_Roles_Check : <<include>>

' RBAC Inclusion
UC_Login ..> UC_RBAC_Routing : <<include>>
UC_Login ..> UC_Auth_Check : <<include>>

' Checkout relations
UC_Checkout ..> UC_Auth_Check : <<include>>
UC_Checkout ..> UC_Deduct_Stock : <<include>>
UC_Checkout ..> UC_Process_Payment : <<include>>
UC_Checkout ..> UC_Loyalty : <<include>>
UC_Voucher ..> UC_Checkout : <<extend>>

' Gateway relation
UC_Process_Payment --> Gateway

@enduml
