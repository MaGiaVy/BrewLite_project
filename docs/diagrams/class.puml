@startuml class
' Thành viên thực hiện: Nguyễn Gia Thành (Task 2.3 - Domain & Application Class Diagram)
' Đồng bộ 100% với apps/api/prisma/schema.prisma và apps/api/src/**
title UML Class Diagram — Hệ Thống BrewLite\n(12 Prisma Models, 4 Enums & NestJS Domain Services/Controllers)

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam DefaultFontName "Arial"
skinparam DefaultFontSize 10
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
set namespaceSeparator none

' ==============================================================================
' 1. IDENTITY, ACCESS CONTROL & LOYALTY (IAM / RBAC)
' ==============================================================================
package "1. Identity, RBAC & Loyalty (auth, users, customers)" {

    enum Role <<enumeration>> {
        CUSTOMER
        STAFF
        ADMIN
    }

    class User <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + email: String <<Unique>>
        + passwordHash: String
        + fullName: String?
        + phone: String?
        + position: String?
        + isActive: Boolean = true
        + role: Role = CUSTOMER
        + loyaltyPoints: Int = 0
        + tokenVersion: Int = 0
        + createdAt: DateTime
    }

    class UserVoucher <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + userId: Int <<FK>>
        + code: String
        + quantity: Int = 1
        + discountPercent: Float
        + minOrderAmount: Float = 0
        + maxDiscountAmount: Float?
        + createdAt: DateTime
        + updatedAt: DateTime
        <<Unique(userId, code)>>
    }

    class AuthController <<Controller>> {
        + register(dto: RegisterDto)
        + login(dto: LoginDto)
        + getProfile(req)
        + updateProfile(req, dto: UpdateProfileDto)
        + redeemPoints(req, dto: RedeemPointsDto)
        + getUserVouchers(req)
    }

    class AuthService <<Service>> {
        + register(dto: RegisterDto)
        + login(dto: LoginDto)
        + getProfile(userId: Int)
        + updateProfile(userId: Int, dto: UpdateProfileDto)
        + getUserVouchers(userId: Int)
        + redeemPoints(userId: Int, points: Int, desc?, voucherCode?)
    }

    class UsersController <<Controller>> {
        + getAllStaff()
        + getStaffById(id: Int)
        + createStaff(req, dto: CreateStaffDto)
        + updateStaff(id: Int, dto: UpdateStaffDto, req)
        + toggleStaffStatus(id: Int, dto: ToggleStatusDto, req)
        + deleteStaff(id: Int, req)
    }

    class UsersService <<Service>> {
        + getAllStaff()
        + getStaffById(id: Int)
        + createStaff(dto: CreateStaffDto, creator?)
        + updateStaff(id: Int, dto: UpdateStaffDto, currentAdminId?)
        + toggleStaffStatus(id: Int, isActive: Boolean, currentAdminId?)
        + deleteStaff(id: Int, currentAdminId?)
    }

    class CustomersController <<Controller>> {
        + getAllCustomers()
        + getCustomerById(id: Int)
        + createCustomer(dto: CreateCustomerDto)
        + updateCustomer(id: Int, dto: UpdateCustomerDto)
        + toggleCustomerStatus(id: Int, dto: ToggleStatusDto)
        + deleteCustomer(id: Int)
    }

    class CustomersService <<Service>> {
        + getAllCustomers()
        + getCustomerById(id: Int)
        + createCustomer(dto: CreateCustomerDto)
        + updateCustomer(id: Int, dto: UpdateCustomerDto)
        + toggleCustomerStatus(id: Int, isActive: Boolean)
        + deleteCustomer(id: Int)
    }

    User "1" *-- "0..*" UserVoucher : owns (Cascade) >
    User --> Role : has >
    AuthController --> AuthService
    UsersController --> UsersService
    CustomersController --> CustomersService
    AuthService ..> User
    AuthService ..> UserVoucher
    UsersService ..> User
    CustomersService ..> User
}

' ==============================================================================
' 2. CATALOG, BOM & INVENTORY ENGINE (products, inventory)
' ==============================================================================
package "2. Catalog, BOM & Inventory (products, inventory)" {

    class Product <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + name: String
        + description: String?
        + imageUrl: String?
        + basePrice: Float
        + sizeUpchargeM: Float?
        + sizeUpchargeL: Float?
        + category: String = "vietnamese"
        + tag: String? = "Phổ biến"
        + isActive: Boolean = true
        + isSoldOutManual: Boolean = false
        + createdAt: DateTime
        + updatedAt: DateTime
    }

    class Ingredient <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + code: String <<Unique>>
        + name: String
        + unit: String
        + stock: Float = 0
        + minThreshold: Float = 100
        + costPerUnit: Float = 0
        + type: String = "INGREDIENT"
        + isRequiredForSale: Boolean = true
        + version: Int = 0 <<OptimisticLock>>
        + createdAt: DateTime
        + updatedAt: DateTime
    }

    class Recipe <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + productId: Int <<FK>>
        + ingredientId: Int <<FK>>
        + size: String = "ALL"
        + amount: Float
        <<Unique(productId, ingredientId, size)>>
    }

    class ToppingRecipe <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + toppingId: String
        + toppingName: String
        + subtext: String? = "Topping thơm ngon chuẩn vị"
        + price: Float = 8000
        + isActive: Boolean = true
        + ingredientId: Int <<FK>>
        + amount: Float
        <<Unique(toppingId, ingredientId)>>
    }

    class InventoryLog <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + ingredientId: Int <<FK>>
        + ingredientName: String
        + unit: String
        + type: String = "RESTOCK"
        + changeAmount: Float
        + previousStock: Float
        + newStock: Float
        + unitCost: Float = 0
        + totalCost: Float = 0
        + note: String?
        + performedBy: String?
        + createdAt: DateTime
    }

    class StoreSetting <<Entity>> {
        + key: String <<PK>>
        + value: String
        + description: String?
        + updatedAt: DateTime
    }

    class ProductsController <<Controller>> {
        + findAll(includeInactive?, req?)
        + findOne(id: Int, req?)
        + create(dto: CreateProductDto)
        + toggleSoldOut(id: Int, dto: ToggleSoldOutDto, req?)
        + toggleVisibility(id: Int, dto: ToggleProductVisibilityDto)
        + update(id: Int, dto: UpdateProductDto)
        + remove(id: Int)
    }

    class ProductsService <<Service>> {
        + findAll(includeInactive?: Boolean, isAdmin?: Boolean)
        + findOne(id: Int, isAdmin?: Boolean, allowInactive?: Boolean)
        + create(dto: CreateProductDto)
        + update(id: Int, dto: UpdateProductDto)
        + toggleVisibility(id: Int, dto: ToggleProductVisibilityDto)
        + toggleSoldOut(id: Int, dto: ToggleSoldOutDto, isAdmin?: Boolean)
        + remove(id: Int)
    }

    class InventoryController <<Controller>> {
        + getPublicPricingConfig()
        + updateGlobalSizePricing(dto)
        + getInventoryRoot(req?) / getAllIngredients(req?)
        + createIngredient(dto) / updateIngredient(id, dto) / deleteIngredient(id)
        + restockIngredient(id, dto, req) / setIngredientStock(id, dto, req)
        + getInventoryLogs() / getDashboardStats()
        + getRecipeMatrix(req?) / upsertRecipe(dto) / updateRecipe(id, dto) / deleteRecipe(id)
        + createToppingRecipe(dto) / updateToppingRecipe(id, dto) / deleteToppingRecipe(id)
        + getAllVouchers() / createVoucher(dto) / updateVoucher(id, dto) / deleteVoucher(id)
    }

    class InventoryService <<Service>> {
        + calculateServings(product)
        + getAllIngredients(isAdmin?: Boolean)
        + createIngredient(dto) / updateIngredient(id, dto) / deleteIngredient(id)
        + restockIngredient(id, dto, actor) / setIngredientStock(id, dto, actor)
        + getInventoryLogs() / getDashboardStats()
        + getRecipeMatrix(isAdmin?: Boolean) / upsertRecipe(dto) / updateRecipe(id, dto) / deleteRecipe(id)
        + createToppingRecipe(dto) / updateToppingRecipe(id, dto) / deleteToppingRecipe(id)
        + getPublicPricingConfig() / getGlobalSizePricing() / updateGlobalSizePricing(dto)
        + getAllVouchers(onlyActive?: Boolean) / createVoucher(dto) / updateVoucher(id, dto) / deleteVoucher(id)
    }

    Product "1" *-- "0..*" Recipe : defines BOM (Cascade) >
    Ingredient "1" <-- "0..*" Recipe : requires (Cascade) <
    Ingredient "1" <-- "0..*" ToppingRecipe : consumes (Cascade) <
    Ingredient "1" *-- "0..*" InventoryLog : audit (Restrict) >
    ProductsController --> ProductsService
    InventoryController --> InventoryService
    ProductsService ..> Product
    ProductsService ..> ToppingRecipe
    InventoryService ..> Ingredient
    InventoryService ..> Recipe
    InventoryService ..> ToppingRecipe
    InventoryService ..> InventoryLog
    InventoryService ..> StoreSetting
}

' ==============================================================================
' 3. SALES, ORDERS & PAYMENTS (orders, payments, jobs, health)
' ==============================================================================
package "3. Orders, Payments & System (orders, payments, jobs, health)" {

    enum OrderStatus <<enumeration>> {
        PENDING
        PAID
        PREPARING
        READY
        COMPLETED
        PAYMENT_FAILED
        CANCELLED
    }

    enum PaymentMethod <<enumeration>> {
        EWALLET
        BANK_CARD
    }

    enum PaymentStatus <<enumeration>> {
        SUCCESS
        FAILED
        PENDING
    }

    class DiscountCode <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + code: String <<Unique>>
        + description: String?
        + discountPercent: Float
        + minOrderAmount: Float = 0
        + maxDiscountAmount: Float?
        + isActive: Boolean = true
        + usageCount: Int = 0
        + createdAt: DateTime
        + updatedAt: DateTime
    }

    class Order <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + userId: Int? <<FK>>
        + status: OrderStatus = PENDING
        + totalAmount: Float
        + discountCode: String?
        + discountAmount: Float = 0
        + voucherDeducted: Boolean = false
        + voucherDiscountPercent: Float?
        + voucherMinOrderAmount: Float?
        + voucherMaxDiscountAmount: Float?
        + version: Int = 0 <<OptimisticLock>>
        + idempotencyKey: String?
        + idempotencyPayload: String?
        + staffId: Int?
        + staffName: String?
        + createdAt: DateTime
        + updatedAt: DateTime
        <<Unique(userId, idempotencyKey)>>
    }

    class OrderItem <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + orderId: Int <<FK>>
        + productId: Int
        + productName: String
        + size: String
        + sugarLevel: String? = "100%"
        + iceLevel: String? = "100%"
        + temperature: String? = "COLD"
        + notes: String?
        + toppings: String[]
        + quantity: Int
        + unitPrice: Float
    }

    class Payment <<Entity>> {
        + id: Int <<PK, autoincrement>>
        + orderId: Int <<FK>>
        + idempotencyKey: String? <<Unique>>
        + amount: Float
        + method: PaymentMethod
        + status: PaymentStatus
        + createdAt: DateTime
    }

    class OrdersController <<Controller>> {
        + createOrder(req, dto: CreateOrderDto, idempotencyKey?)
        + findAllForAdmin()
        + getMyOrders(req)
        + getBaristaQueue()
        + getOrderById(req, id: Int)
        + updateOrderStatus(req, id: Int, dto: UpdateOrderStatusDto)
        + deleteOrder(req, id: Int)
    }

    class OrdersService <<Service>> {
        + createOrder(dto: CreateOrderDto, userId: Int, idempotencyKey?)
        + getAllOrdersForAdmin()
        + getMyOrders(userId: Int)
        + getBaristaQueue()
        + updateOrderStatus(orderId: Int, nextStatus: OrderStatus, userId: Int, userRole?)
        + getOrderById(orderId: Int, userId: Int, userRole?)
        + deleteOrder(orderId: Int, userId: Int, userRole?)
        + cancelExpiredPendingOrders(): Promise<number>
    }

    class ExpireOrdersJob <<ScheduledJob>> {
        + handleExpiredOrders(): Promise<void>
    }

    class PaymentsController <<Controller>> {
        + processPayment(req, dto: CreatePaymentDto, idempotencyKey?)
        + createZaloPayOrder(req, orderId: Int)
        + handleZaloPayCallback(body)
        + getZaloPayStatus(req, orderId: Int, appTransId?)
        + confirmZaloPayOrder(req, orderId?, appTransId?)
        + cancelZaloPayOrder(req, orderId: Int)
    }

    class PaymentsService <<Service>> {
        + processPayment(dto: CreatePaymentDto, userId: Int, idempotencyKey?, userRole?)
        + createZaloPayOrder(orderId: Int, userId: Int, userRole?)
        + handleZaloPayCallback(body)
        + getZaloPayStatus(orderId: Int, userId: Int, appTransId?, userRole?)
        + confirmZaloPaySandbox(orderId?, userId, userRole?, appTransId?)
        + cancelZaloPaySandbox(orderId: Int, userId: Int, userRole?)
    }

    class MockGatewayService <<Service>> {
        + charge(amount: Float, method: PaymentMethod, simulateFailure?)
    }

    class MockPaymentService <<Service>> {
        + processPayment(params: ProcessPaymentParams): Promise<PaymentResult>
    }

    class ZaloPayService <<Service>> {
        + generateAppTransId(orderId: Int): String
        + computeCreateOrderMac(params): String
        + createOrder(params: ZaloPayCreateOrderParams)
        + verifyCallback(dataStr: String, requestMac: String): Boolean
        + queryStatus(appTransId: String)
        + createMockCallbackPayload(orderId, amount, appTransId, zpTransId?)
    }

    class HealthController <<Controller>> {
        + check(): Promise<HealthResponse>
    }

    User "0..1" <-- "0..*" Order : places <
    Order "1" *-- "1..*" OrderItem : contains (Cascade) >
    OrderItem ..> Product : snapshot productId >
    Order "1" *-- "0..*" Payment : settled by (Restrict) >
    Order --> OrderStatus : state >
    Order ..> DiscountCode : applies >
    Payment --> PaymentMethod : uses >
    Payment --> PaymentStatus : status >

    OrdersController --> OrdersService
    ExpireOrdersJob ..> OrdersService : "expires >TTL"
    PaymentsController --> PaymentsService
    PaymentsService --> MockGatewayService
    PaymentsService --> MockPaymentService
    PaymentsService --> ZaloPayService
    OrdersService ..> Order
    PaymentsService ..> Payment
    PaymentsService ..> Order
}

' ==============================================================================
' 4. CROSS-CUTTING GUARDS, PIPES, FILTERS & CORE HELPERS
' ==============================================================================
package "4. Guards, Pipes, Filters & Helpers (common, auth, orders, payments)" {

    class JwtAuthGuard <<Guard>> {
        + canActivate(context)
    }

    class OptionalJwtAuthGuard <<Guard>> {
        + handleRequest(err, user)
    }

    class RolesGuard <<Guard>> {
        - reflector: Reflector
        + canActivate(context): Boolean
    }

    class JwtStrategy <<Strategy>> {
        + validate(payload: JwtPayload): JwtUserPayload
    }

    class ParseInt32Pipe <<Pipe>> {
        - optional: Boolean
        - min: Int
        + transform(value, metadata): Int?
    }

    class PrismaExceptionFilter <<Filter>> {
        + catch(exception: PrismaClientKnownRequestError, host)
    }

    class "bom.helper" as BomHelper <<Helper>> {
        + computeRequiredIngredients(tx, items, options): Promise<RequiredIngredientItem[]>
    }

    class "order-refund.helper" as OrderRefundHelper <<Helper>> {
        + refundOrderResources(tx, order, options)
        + expirePendingOrders(prisma, logger?, scope?): Promise<number>
    }

    class "state-machine.helper" as StateMachineHelper <<Helper>> {
        + ALLOWED_TRANSITIONS: Record<OrderStatus, OrderStatus[]>
        + assertTransition(current: OrderStatus, next: OrderStatus): void
        .. State Machine Rule ..
        PAYMENT_FAILED -> PENDING | CANCELLED (không đi thẳng PAID)
    }

    JwtAuthGuard ..> JwtStrategy : delegates >
    OrdersService ..> BomHelper
    OrdersService ..> OrderRefundHelper
    OrdersService ..> StateMachineHelper
    PaymentsService ..> OrderRefundHelper
    PaymentsService ..> StateMachineHelper
    ExpireOrdersJob ..> OrderRefundHelper
}

note bottom of HealthController
  • BOM Stock & COGS: không lưu stock tĩnh trên Product; tính động từ Ingredient.stock / Recipe.amount.
  • Optimistic Locking: Ingredient.version (chống overselling) & Order.version (State Machine CAS).
  • Idempotency: Order(userId, idempotencyKey) & Payment.idempotencyKey; Soft Delete qua isActive.
end note

@enduml
