@startuml
autonumber
skinparam actorStyle awesome
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 11

skinparam sequence {
    ArrowColor #2C3E50
    ActorBorderColor #2980B9
    ActorBackgroundColor #EBF5FB
    ParticipantBorderColor #34495E
    ParticipantBackgroundColor #FFFFFF
    LifeLineBorderColor #7F8C8D
    LifeLineBackgroundColor #F2F4F4
    GroupBorderColor #BDC3C7
    GroupBackgroundColor #FAFAFA
    GroupHeaderFontColor #2C3E50
    AltBorderColor #E67E22
    AltBackgroundColor #FEF9E7
}

title **SƠ ĐỒ TUẦN TỰ (SEQUENCE DIAGRAM) - ĐĂNG KÝ VÀ ĐĂNG NHẬP PHÂN QUYỀN (RBAC)**\n<size:11>Hệ thống BrewLite - Cashless Specialty Coffee Platform (Next.js & NestJS)</size>

' ==============================================================================
' PARTICIPANTS & LIFELINES
' ==============================================================================
actor "Người dùng / Khách truy cập\n(User / Guest)" as User #D1E8FF
boundary "Giao diện Xác thực\n(Next.js App / AuthStore)" as UI #E8F4FD
control "AuthController\n(NestJS REST API)" as Controller #FFF2CC
control "AuthService\n(Bcrypt & JwtService)" as Service #FEF9E7
database "Database\n(PostgreSQL / Prisma)" as DB #F8CECC

' ==============================================================================
' PHÂN ĐOẠN 1: ĐĂNG KÝ TÀI KHOẢN KHÁCH HÀNG (REGISTER)
' ==============================================================================
box "PHÂN HỆ XÁC THỰC (AUTHENTICATION MODULE)" #F8F9F9

group Đăng ký tài khoản khách hàng (Register)
    User -> UI : Nhập họ tên, email, số điện thoại, mật khẩu, xác nhận mật khẩu rồi bấm "Đăng ký"
    activate UI
    
    UI -> UI : Kiểm tra dữ liệu phía Client (so khớp mật khẩu xác nhận, kiểm tra trường rỗng)
    
    alt #FADBD8 Mật khẩu xác nhận không khớp
        UI --> User : Hiển thị thông báo lỗi "Mật khẩu xác nhận không khớp"
    else #EAFAF1 Dữ liệu phía giao diện hợp lệ
        UI -> Controller : POST /auth/register (fullName, email, phone, password)
        activate Controller
        
        Controller -> Controller : Validate qua ValidationPipe(RegisterDto)\n(Email chuẩn RFC, Mật khẩu >= 6 ký tự, Họ tên không rỗng)
        
        alt #FADBD8 Dữ liệu DTO không hợp lệ (HTTP 400)
            Controller --> UI : Trả lỗi 400 Bad Request (kèm danh sách trường vi phạm validation)
            UI --> User : Hiển thị thông báo lỗi chi tiết cạnh từng trường nhập liệu
        else #EAFAF1 Dữ liệu DTO hợp lệ
            Controller -> Service : register(RegisterDto)
            activate Service
            
            Service -> DB : prisma.user.findUnique({ where: { email } })
            activate DB
            DB --> Service : Kết quả tìm kiếm (existingUser)
            deactivate DB
            
            alt #FADBD8 Email đã tồn tại trong hệ thống (HTTP 409)
                Service --> Controller : Ném ngoại lệ ConflictException(409)
                Controller --> UI : Trả lỗi HTTP 409 "Email này đã được đăng ký. Vui lòng đăng nhập hoặc dùng email khác."
                UI --> User : Hiển thị cảnh báo lỗi, gợi ý người dùng chuyển sang tab Đăng nhập
            else #EAFAF1 Email hợp lệ (chưa từng đăng ký)
                Service -> Service : Mã hóa mật khẩu an toàn: bcrypt.hash(password, SALT_ROUNDS=10)
                Service -> DB : prisma.user.create({\n  email, passwordHash, fullName, phone,\n  role: 'CUSTOMER', loyaltyPoints: 0\n})
                activate DB
                DB --> Service : Bản ghi User mới được tạo (id, createdAt)
                deactivate DB
                
                Service -> Service : Tạo JWT Token có hạn 24 giờ:\njwtService.sign({ sub: user.id, email, role: 'CUSTOMER' })
                Service --> Controller : Trả về { accessToken, user: safeUser }
                deactivate Service
                
                Controller --> UI : Trả kết quả HTTP 201 Created kèm accessToken và profile người dùng
                deactivate Controller
                
                UI -> UI : authStore.setAuth(user, token) - Lưu token & user vào LocalStorage
                
                alt #E8F8F5 Khách hàng đăng ký khi đang dở luồng đặt hàng (redirect = '/checkout')
                    UI --> User : Hiển thị thông báo chào mừng & tự động chuyển hướng đến trang /checkout
                else #EBF5FB Luồng đăng ký thông thường
                    UI --> User : Hiển thị "Đăng ký thành viên thành công!" & chuyển hướng đến /menu
                end
            end
        end
    end
    deactivate UI
end

' ==============================================================================
' PHÂN ĐOẠN 2: ĐĂNG NHẬP & ĐIỀU HƯỚNG PHÂN QUYỀN (LOGIN & RBAC ROUTING)
' ==============================================================================
group Đăng nhập & Điều hướng Phân quyền (Login & RBAC Routing)
    User -> UI : Nhập email, mật khẩu rồi bấm "Đăng nhập"
    activate UI
    
    UI -> Controller : POST /auth/login (email, password)
    activate Controller
    
    Controller -> Controller : Validate qua ValidationPipe(LoginDto)\n(Định dạng email, mật khẩu không được rỗng)
    
    alt #FADBD8 Dữ liệu đầu vào không hợp lệ (HTTP 400)
        Controller --> UI : Trả lỗi 400 Bad Request (kèm danh sách lỗi)
        UI --> User : Hiển thị thông báo lỗi định dạng dữ liệu
    else #EAFAF1 Dữ liệu đầu vào hợp lệ
        Controller -> Service : login(LoginDto)
        activate Service
        
        Service -> DB : prisma.user.findUnique({\n  where: { email },\n  include: { vouchers: true }\n})
        activate DB
        DB --> Service : Thông tin User (hoặc null nếu không tìm thấy)
        deactivate DB
        
        alt #FADBD8 Email không tồn tại (OWASP - Chống rà soát tài khoản)
            Service --> Controller : Ném ngoại lệ UnauthorizedException(401)
            Controller --> UI : Trả lỗi HTTP 401 "Email hoặc mật khẩu không chính xác. Vui lòng thử lại."
            UI --> User : Hiển thị thông báo "Email hoặc mật khẩu không chính xác"
        else #EAFAF1 Email tồn tại trong hệ thống
            Service -> Service : So khớp mật khẩu: bcrypt.compare(dto.password, user.passwordHash)
            
            alt #FADBD8 Mật khẩu không chính xác (HTTP 401)
                Service --> Controller : Ném ngoại lệ UnauthorizedException(401)
                Controller --> UI : Trả lỗi HTTP 401 "Email hoặc mật khẩu không chính xác. Vui lòng thử lại."
                UI --> User : Hiển thị thông báo "Email hoặc mật khẩu không chính xác"
            else #EAFAF1 Mật khẩu chính xác tuyệt đối
                Service -> Service : Tạo mã xác thực JWT (hạn 24h):\njwtService.sign({ sub: user.id, email: user.email, role: user.role })
                Service --> Controller : Trả mã xác thực accessToken và thông tin safeUser (kèm role)
                deactivate Service
                
                Controller --> UI : Trả kết quả HTTP 200 OK kèm accessToken và user profile
                deactivate Controller
                
                UI -> UI : authStore.setAuth(user, token) - Lưu JWT vào LocalStorage và cập nhật Zustand store
                
                alt #FDEBD0 [Vai trò ADMIN] Quản trị viên
                    UI -> UI : getRoleDestination() điều hướng sang /admin
                    UI --> User : Chuyển hướng vào Cổng Quản trị BrewLite (Dashboard, Menu CRUD, BOM, Kho)
                else #FCF3CF [Vai trò STAFF] Nhân viên pha chế
                    UI -> UI : getRoleDestination() điều hướng sang /staff
                    UI --> User : Chuyển hướng vào Màn hình Điều phối Quầy Bar KDS (Kitchen Display System)
                else #D4EFDF [Vai trò CUSTOMER] Khách hàng thành viên
                    alt #E8F8F5 Có giỏ hàng chờ thanh toán (redirect = '/checkout')
                        UI -> UI : getRoleDestination() trả về '/checkout'
                        UI --> User : Chuyển hướng thẳng sang /checkout (giữ nguyên giỏ hàng, áp dụng điểm Loyalty)
                    else #EBF5FB Đăng nhập thông thường
                        UI -> UI : getRoleDestination() trả về '/menu'
                        UI --> User : Chuyển hướng sang /menu (Hiển thị thực đơn và thẻ thành viên)
                    end
                end
            end
        end
    end
    deactivate UI
end

end box

@enduml
