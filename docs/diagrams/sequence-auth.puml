@startuml
skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 11
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true

autonumber

actor "Người dùng\n(Khách hàng / Barista / Admin)" as User
boundary "Giao diện Xác thực\n(Đăng ký / Đăng nhập)" as UI
control "Controller\n(NestJS)" as Controller
control "Service\n(Xử lý nghiệp vụ)" as Service
database "Database\n(Prisma)" as DB

== Đăng ký tài khoản ==

User -> UI : Nhập họ tên, email, mật khẩu, xác nhận mật khẩu (kèm số điện thoại) rồi bấm "Đăng ký"
activate UI
UI -> UI : Kiểm tra dữ liệu phía giao diện

alt Mật khẩu xác nhận không khớp
    UI --> User : Hiển thị lỗi "Mật khẩu không khớp"
else Dữ liệu phía giao diện hợp lệ
    UI -> Controller : Gửi yêu cầu đăng ký (email, mật khẩu, họ tên, số điện thoại)
    activate Controller
    Controller -> Controller : Kiểm tra định dạng email và mật khẩu có ít nhất 6 ký tự
    
    alt Dữ liệu không hợp lệ
        Controller --> UI : Trả lỗi dữ liệu không hợp lệ (kèm danh sách trường sai)
        UI --> User : Hiển thị lỗi cạnh từng trường nhập
    else Dữ liệu hợp lệ
        Controller -> Service : Yêu cầu đăng ký người dùng
        activate Service
        Service -> DB : Tìm người dùng theo email
        activate DB
        DB --> Service : Kết quả tìm kiếm
        deactivate DB
        
        alt Email đã được đăng ký
            Service --> Controller : Báo email đã tồn tại
            Controller --> UI : Trả lỗi 409 "Email đã được đăng ký"
            UI --> User : Hiển thị lỗi, yêu cầu dùng email khác
        else Email chưa tồn tại
            Service -> Service : Mã hóa mật khẩu (bcrypt)
            Service -> DB : Lưu người dùng mới (vai trò Khách hàng, điểm tích lũy ban đầu bằng 0)
            activate DB
            DB --> Service : Người dùng đã được lưu
            deactivate DB
            Service -> Service : Tạo mã xác thực (JWT) có hạn dùng 7 ngày
            Service --> Controller : Trả thông tin người dùng mới và mã xác thực (JWT)
            deactivate Service
            Controller --> UI : Trả kết quả đăng ký thành công kèm mã xác thực (JWT)
            deactivate Controller
            UI -> UI : Lưu mã xác thực vào bộ nhớ trình duyệt và cập nhật trạng thái đăng nhập
            UI --> User : Chuyển thẳng sang trang Checkout (hoặc trang Thực đơn)
        end
    end
end
deactivate UI

== Đăng nhập ==

User -> UI : Nhập email, mật khẩu rồi bấm "Đăng nhập"
activate UI
UI -> Controller : Gửi yêu cầu đăng nhập (email, mật khẩu)
activate Controller
Controller -> Controller : Kiểm tra định dạng dữ liệu đầu vào

alt Dữ liệu đầu vào không hợp lệ
    Controller --> UI : Trả lỗi dữ liệu không hợp lệ
    UI --> User : Hiển thị lỗi cạnh từng trường nhập
else Dữ liệu đầu vào hợp lệ
    Controller -> Service : Yêu cầu đăng nhập
    activate Service
    Service -> DB : Tìm người dùng theo email
    activate DB
    DB --> Service : Thông tin người dùng (hoặc không có)
    deactivate DB
    
    alt Email không tồn tại
        Service --> Controller : Báo thông tin đăng nhập sai
        Controller --> UI : Trả lỗi "Email hoặc mật khẩu không chính xác"
        UI --> User : Hiển thị lỗi "Email hoặc mật khẩu không chính xác"
    else Email tồn tại
        Service -> Service : So khớp mật khẩu nhập vào với mật khẩu đã mã hóa
        
        alt Mật khẩu sai
            Service --> Controller : Báo thông tin đăng nhập sai
            Controller --> UI : Trả lỗi "Email hoặc mật khẩu không chính xác"
            UI --> User : Hiển thị lỗi "Email hoặc mật khẩu không chính xác"
        else Mật khẩu đúng
            Service -> Service : Tạo mã xác thực (JWT) chứa vai trò (Role), có hạn dùng 7 ngày
            Service --> Controller : Trả mã xác thực và thông tin người dùng
            deactivate Service
            Controller --> UI : Trả kết quả đăng nhập thành công kèm mã xác thực
            deactivate Controller
            UI -> UI : Lưu mã xác thực vào bộ nhớ trình duyệt và cập nhật trạng thái đăng nhập
            UI --> User : Hiển thị "Đăng nhập thành công" và điều hướng phân quyền (Admin -> Quản trị, Staff -> Quầy pha chế, Khách hàng -> Đặt món/Checkout)
        end
    end
end
deactivate UI

@enduml
