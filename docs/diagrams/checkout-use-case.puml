@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam roundcorner 10

' Chuẩn UML tối giản đen trắng, sắc nét, không màu mè
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actor {
    BorderColor black
    BackgroundColor white
}
skinparam usecase {
    BorderColor black
    BackgroundColor white
    ArrowColor black
}
skinparam rectangle {
    BorderColor black
    BackgroundColor white
}

' Thành viên thực hiện: Nguyễn Thị Ý (Task 1.3 - Use Case Checkout)
title SƠ ĐỒ USE CASE PHÂN HỆ ĐẶT HÀNG & THANH TOÁN (CHECKOUT & PAYMENT)\n(Tách biệt rõ ràng 2 nghiệp vụ Tạo đơn hàng & Thanh toán trong cùng phân hệ)

' ==========================================
' ACTOR BÊN TRÁI (Khách hàng)
' ==========================================
actor "Khách hàng" as Customer

' ==========================================
' SYSTEM BOUNDARY (Phân hệ Đặt hàng & Thanh toán)
' ==========================================
rectangle "Phân hệ Đặt hàng & Thanh toán (Checkout & Payment Subsystem)" {

    ' ------------------------------------------
    ' NHÓM 1: TẠO ĐƠN HÀNG (ORDER CREATION)
    ' ------------------------------------------
    usecase "Tạo đơn hàng\n(Đặt hàng)" as UC_CreateOrder
    
    usecase "Xác thực đăng nhập\n(JWT)" as UC_Auth
    usecase "Kiểm tra tồn kho BOM\n& Khóa Optimistic" as UC_Stock
    usecase "Áp dụng mã giảm giá\n(Voucher)" as UC_Voucher

    ' ------------------------------------------
    ' NHÓM 2: THANH TOÁN ĐƠN HÀNG (PAYMENT PROCESSING)
    ' ------------------------------------------
    usecase "Thanh toán đơn hàng\n(Checkout)" as UC_Payment

    usecase "Xử lý thanh toán trực tuyến\n(ZaloPay / Mock)" as UC_ProcessPay
    usecase "Tích lũy điểm Loyalty\n(1.000đ = 1đ Hạt Vàng)" as UC_Loyalty
    usecase "Thanh toán lại khi lỗi\n(Retry Payment)" as UC_Retry
    usecase "Hủy đơn hàng\n(Grace Period 5p / Hết hạn 15p)" as UC_Cancel

    ' ==========================================
    ' CÁC MỐI QUAN HỆ TRONG NHÓM TẠO ĐƠN HÀNG
    ' ==========================================
    UC_CreateOrder ..> UC_Auth : <<include>>
    UC_CreateOrder ..> UC_Stock : <<include>>
    UC_Voucher ..> UC_CreateOrder : <<extend>>

    ' ==========================================
    ' LIÊN KẾT GIỮA 2 USE CASE CHÍNH
    ' ==========================================
    UC_CreateOrder ..> UC_Payment : <<include>>

    ' ==========================================
    ' CÁC MỐI QUAN HỆ TRONG NHÓM THANH TOÁN
    ' ==========================================
    UC_Payment ..> UC_ProcessPay : <<include>>
    UC_Payment ..> UC_Loyalty : <<include>>
    UC_Retry ..> UC_Payment : <<extend>>
    UC_Cancel ..> UC_Payment : <<extend>>
}

' ==========================================
' ACTOR BÊN PHẢI (Cổng thanh toán)
' ==========================================
actor "Cổng thanh toán điện tử\n(ZaloPay Sandbox / Mock Gateway)" as PaymentGateway

' ==========================================
' LIÊN KẾT TÁC NHÂN (ACTOR ASSOCIATIONS)
' ==========================================
Customer --> UC_CreateOrder
Customer --> UC_Retry
Customer --> UC_Cancel

UC_ProcessPay --> PaymentGateway

@enduml
