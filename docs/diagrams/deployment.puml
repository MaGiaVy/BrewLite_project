@startuml deployment
' Thành viên thực hiện: Quách Kỳ Minh (Task 3.2 - Deployment Diagram)
' Đồng bộ Production (Vercel + Render Docker + Supabase PostgreSQL), Local Docker Compose, CI/CD
title UML Deployment Diagram — Hệ Thống BrewLite (Production: Vercel + Render + Supabase)

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam DefaultFontName "Arial"
skinparam DefaultFontSize 11
skinparam nodesep 35
skinparam ranksep 45
set namespaceSeparator none

' ==============================================================================
' 1. THIẾT BỊ NGƯỜI DÙNG (CLIENT) & CI/CD (GITHUB)
' ==============================================================================
node "Thiết Bị Người Dùng\n<<device>>" as client_device {
    node "Trình Duyệt Web / PWA Mobile\n<<executionEnvironment>>" as client_browser {
        artifact "BrewLite Web App\n(React 19 / Next.js 15.1.6 Client)\n[TailwindCSS, Zustand, Idempotency-Key]" as spa_client
    }
}

node "Hạ Tầng CI/CD (GitHub Cloud)\n<<cloud>>" as ci_env {
    node "GitHub Repository\n(MaGiaVy/BrewLite_project) <<vcs>>" as gh_repo {
        artifact "main / PRs / Tag v1.0.0\n[apps/web, apps/api, docs, tests, scripts]" as git_source
    }

    node "GitHub Actions Runner\n<<executionEnvironment: ubuntu-latest>>" as gh_runner {
        component "CI (.github/workflows/ci.yml)\n[PR -> main: lint, test, build]" as ci_pipeline
        component "CD (.github/workflows/cd.yml)\n[workflow_dispatch (nhánh main): publish-api | publish | deploy | rollback\nGitleaks v3 -> GHCR -> vars.RENDER_* + Smoke]" as cd_pipeline
    }

    node "GitHub Container Registry (Optional)\n<<registry: ghcr.io>>" as ghcr_registry {
        artifact "ghcr.io/<owner>/brewlite-web:<tag>\nghc.io/<owner>/brewlite-api:<tag>" as ghcr_images
    }

    note bottom of ghcr_registry
        Secrets & Vars (cd.yml chỉ chạy qua workflow_dispatch trên main):
        • Gitleaks v3 scan lịch sử git trong cd.yml
        • Secrets: GITHUB_TOKEN, RENDER_API_KEY, RENDER_API_DEPLOY_HOOK, RENDER_WEB_DEPLOY_HOOK
        • Vars: vars.RENDER_API_URL, vars.RENDER_WEB_URL, vars.RENDER_API_SERVICE_ID, vars.RENDER_WEB_SERVICE_ID
    end note
}

' ==============================================================================
' 2. MÔI TRƯỜNG PRODUCTION (VERCEL + RENDER + SUPABASE)
' ==============================================================================
node "Môi Trường Production (HTTPS / TLS 1.3)" as prod_env {
    node "Production Frontend: Vercel Cloud\n<<cloud: Global Edge Network>>" as vercel_env {
        node "Vercel Edge CDN & Middleware\n<<loadBalancer / edge>>" as vercel_edge {
            component "TLS 1.3, Edge RBAC (middleware.ts)\nAuto-Deploy from main\n[https://brew-lite-project.vercel.app]" as vercel_proxy
        }
        node "Next.js 15.1.6 Hosting (apps/web)\n<<executionEnvironment>>" as prod_web_node {
            artifact "BrewLite Frontend\n<<app: Next.js Standalone / React 19>>" as prod_web_app
        }
        note bottom of vercel_env
            Vercel Env Vars:
            • NEXT_PUBLIC_API_URL=https://brewlite-api-9viv.onrender.com
        end note
    }

    node "Production Backend: Render Cloud (Singapore)\n<<cloud: Docker Runtime>>" as render_env {
        node "Render Edge TLS Proxy\n<<loadBalancer / reverseProxy>>" as render_edge {
            component "TLS 1.3 Termination & Auto-Deploy main\n[https://brewlite-api-9viv.onrender.com]" as render_proxy
        }
        node "Docker Web Service: brewlite-api\n<<service: Container :3001>>" as prod_api_node {
            artifact "brewlite-api (apps/api/Dockerfile)\n<<container: Node 20 Alpine>>" as prod_api_app {
                component "NestJS 10.4 REST API + Prisma 5.22\n[Entrypoint: migrate deploy + seed | ThrottlerGuard]" as nestjs_engine
            }
        }
        note bottom of prod_api_node
            Health Check & Render Env Vars:
            • GET /health -> {"status":"ok","db":"up"} | 503
            • Bắt buộc (env.validation.ts - 3 biến): DATABASE_URL, JWT_SECRET, MOCK_PAYMENT_MODE
            • Tùy chọn / Mặc định: PORT (3001), NODE_ENV, JWT_EXPIRES_IN, CORS_ORIGIN, WEB_URL,
              ALLOW_MOCK_PAYMENT, ALLOW_SANDBOX_CONFIRM, ZALOPAY_APP_ID / KEY1 / KEY2,
              ZALOPAY_CREATE_ENDPOINT, ZALOPAY_QUERY_ENDPOINT, ZALOPAY_CALLBACK_URL, ZALOPAY_REDIRECT_URL
        end note
    }

    node "Production Database: Supabase Cloud\n<<cloud: Managed PostgreSQL>>" as supabase_env {
        database "Supabase PostgreSQL 16\n<<database: Managed PostgreSQL>>" as prod_db_node {
            storage "Managed SSD Storage & Backups\n<<persistentStorage>>" as prod_disk
        }
        note bottom of supabase_env
            Bảo mật Cơ sở dữ liệu:
            • TLS/SSL bắt buộc (sslmode=require)
            • Chỉ Render API giữ DATABASE_URL
            • Không mở truy cập từ Client
        end note
    }
}

' ==============================================================================
' 3. DỊCH VỤ BÊN THỨ BA & MÔI TRƯỜNG LOCAL
' ==============================================================================
node "Dịch Vụ Thanh Toán Bên Thứ Ba\n<<cloud>>" as ext_services {
    node "Cổng Thanh Toán ZaloPay Sandbox\n<<gateway: sb-openapi.zalopay.vn>>" as zalopay_cloud {
        component "ZaloPay Sandbox Gateway API v2\n[Create Order, Query Status, Webhook Callback]" as zalopay_api
    }
}

node "Môi Trường Local (Developer Workstation)\n<<device: Windows / macOS / Linux>>" as local_env {
    node "Docker Desktop (docker-compose.yml - default bridge network)\n<<executionEnvironment>>" as docker_local {
        artifact "web (Node 20 Alpine)\nNext.js 15.1.6 Standalone\nPort: ${WEB_PORT:-3000}:3000\n[API_INTERNAL_URL=http://api:3001]" as local_web
        artifact "api (Node 20 Alpine)\nNestJS 10.4 + Prisma 5.22\nPort: ${API_PORT:-3001}:3001\n[PORT=3001, NODE_ENV=production, WEB_URL]" as local_api
        database "db: postgres:16-alpine\nPort: ${DB_PORT:-5432}:5432" as local_db {
            storage "brewlite_pgdata\n<<volume>>" as local_vol
        }
    }
    note bottom of local_env
        Cấu hình Local:
        • Docker Compose dùng default bridge network (web -> http://api:3001, api -> db:5432)
        • File .env (từ .env.example, không commit) + docker-entrypoint.sh: migrate deploy + seed
    end note
}

' ==============================================================================
' CÁC KẾT NỐI VÀ GIAO THỨC (PROTOCOLS & CONNECTIONS)
' ==============================================================================
client_device -[hidden]right-> ci_env
prod_env -[hidden]down-> ext_services
ext_services -[hidden]right-> local_env

spa_client --> vercel_edge : "1. HTTPS :443\n(UI / SSR / Assets)"
vercel_edge --> prod_web_app : "Serve Next.js App"
spa_client --> render_edge : "2. HTTPS :443 (CORS + JWT)\nREST API tới brewlite-api"
render_edge --> prod_api_app : "Reverse Proxy (:3001)"

prod_api_app --> prod_db_node : "3. PostgreSQL over TLS/SSL (:5432 / :6543)\nPrisma Pool (DATABASE_URL)"
prod_api_app ..> zalopay_api : "4. HTTPS :443\n(HMAC-SHA256 Create/Status/Callback)"

git_source --> gh_runner : "PR (ci.yml) / workflow_dispatch main (cd.yml)"
git_source --> vercel_edge : "Push main -> Vercel Auto-Deploy"
git_source --> render_edge : "Push main -> Render Auto-Deploy"
gh_runner --> ghcr_registry : "Push Docker Images (cd.yml)"
ghcr_registry ..> prod_api_node : "Deploy Hook / Rollback (Optional)"

local_web --> local_api : "HTTP :3001"
local_api --> local_db : "TCP :5432"
spa_client ..> local_web : "Local Dev: http://localhost:3000"

@enduml
