@startuml deployment
!theme plain
title UML Deployment Diagram — Hệ Thống BrewLite (Task 3.2 - Đợt A)

skinparam DefaultFontName "Arial"
skinparam DefaultFontSize 11
skinparam RoundCorner 12
skinparam Shadowing true

skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #2C1810
    BorderThickness 1.5
    FontColor #2C1810
    FontStyle bold
}

skinparam artifact {
    BackgroundColor #FFF9F5
    BorderColor #D97736
    BorderThickness 1.2
}

skinparam database {
    BackgroundColor #F4ECE1
    BorderColor #845326
    BorderThickness 1.5
    FontColor #2C1810
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #3B82F6
    BorderThickness 1.2
}

skinparam note {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontSize 10
}

' ==============================================================================
' 1. THIẾT BỊ NGƯỜI DÙNG (CLIENT DEVICES)
' ==============================================================================
node "Thiết Bị Người Dùng\n<<device>>" as client_device {
    node "Trình Duyệt Web / PWA Mobile\n<<executionEnvironment>>" as client_browser {
        artifact "BrewLite Web App (React 19 / Next.js Client SPA)\n[HTML5, CSS3, Zustand Store, Service Worker]" as spa_client
    }
}

' ==============================================================================
' 2. MÔI TRƯỜNG LOCAL (DEVELOPMENT ENVIRONMENT)
' ==============================================================================
node "Môi Trường Local (Developer Workstation)\n<<device: Windows / macOS / Linux>>" as local_env {
    node "Docker Desktop Engine\n<<virtualizationEngine>>" as docker_local {
        node "Mạng Cục Bộ (Docker Bridge Network: brewlite_network)\n<<network>>" as local_net {
            artifact "brewlite_frontend:latest\n<<container: Node 22 Alpine>>\nNext.js Dev / SSR Server\nPort: 3000:3000" as local_web
            artifact "brewlite_backend:latest\n<<container: Node 22 Alpine>>\nNestJS REST API Engine\nPort: 3001:3001" as local_api
            database "brewlite_db:postgres:16-alpine\n<<container: PostgreSQL 16>>\nPort: 5433:5432" as local_db {
                storage "postgres_data\n<<volume>>" as local_vol
            }
        }
    }
    note bottom of local_env
        <b>Cấu hình & Secrets Local:</b>
        • File .env và docker-compose.yml
        • Không chứa secret production
        • Quản lý qua Prisma db push / seed
    end note
}

' ==============================================================================
' 3. MÔI TRƯỜNG CI/CD (GITHUB INFRASTRUCTURE)
' ==============================================================================
node "Hạ Tầng CI/CD (GitHub Cloud)\n<<cloud>>" as ci_env {
    node "GitHub Repository\n<<vcs>>" as gh_repo {
        artifact "Git Branch: main / Pull Requests\n[Source Code, Dockerfiles, Migrations]" as git_source
    }
    
    node "GitHub Actions Runner\n<<executionEnvironment: ubuntu-latest>>" as gh_runner {
        component "CI Pipeline Workflow (.github/workflows/ci.yml)\n[1. npm ci & Lint -> 2. Unit/Integration Tests -> 3. Build Docker Image]" as ci_pipeline
        component "CD Pipeline Workflow (.github/workflows/cd.yml)\n[Build Image -> Tag Commit SHA -> Push Registry -> Trigger Deploy]" as cd_pipeline
    }
    
    node "GitHub Container Registry (GHCR)\n<<registry: ghcr.io>>" as ghcr_registry {
        artifact "ghcr.io/brewlite-web:latest" as ghcr_web
        artifact "ghcr.io/brewlite-api:latest" as ghcr_api
    }

    note right of ci_env
        <b>GitHub Repository Secrets:</b>
        • GHCR_TOKEN / GITHUB_TOKEN
        • RENDER_DEPLOY_HOOK_WEB
        • RENDER_DEPLOY_HOOK_API
    end note
}

' ==============================================================================
' 4. MÔI TRƯỜNG PRODUCTION (RENDER CLOUD PLATFORM)
' ==============================================================================
node "Môi Trường Production (Render Cloud PaaS - Singapore Region)\n<<cloud>>" as prod_env {
    node "Render Edge Gateway & CDN\n<<loadBalancer / reverseProxy>>" as render_edge {
        component "TLS 1.3 Termination, DDoS Shield, Brotli/Gzip Compression\n[Domain: *.onrender.com / brewlite.vn]" as edge_proxy
    }

    node "Render Private Network (VPC Nội Bộ)\n<<network: 10.0.0.0/8>>" as prod_private_net {
        node "Web Service: Frontend Web\n<<service: Render Container Engine>>" as prod_web_node {
            artifact "brewlite-frontend\n<<container: Node 22-alpine>>" as prod_web_app {
                component "Next.js 16 (App Router)\nStandalone Output" as nextjs_engine
            }
        }

        node "Web Service: Backend API\n<<service: Render Container Engine>>" as prod_api_node {
            artifact "brewlite-backend\n<<container: Node 22-alpine>>" as prod_api_app {
                component "NestJS 11 REST API\nPrisma ORM 6 Engine" as nestjs_engine
            }
        }

        database "Managed PostgreSQL 16\n<<database: Render Managed PostgreSQL>>" as prod_db_node {
            storage "Render Persistent SSD Disk (10 GB - Auto-backup)\n<<persistentStorage>>" as prod_disk
        }
    }

    note right of prod_web_node
        <b>Port Container: 3000</b>
        Environment:
        • NEXT_PUBLIC_API_URL=https://api.brewlite.vn
    end note

    note right of prod_api_node
        <b>Port Container: 3001</b>
        <b>Health Check Endpoint:</b>
        • GET /health (Probe Interval: 10s)
        <b>Centralized Logging:</b>
        • stdout / stderr -> Render Log Streams
        <b>Runtime Secrets (Render Secret Group):</b>
        • DATABASE_URL (Private host)
        • JWT_SECRET (256-bit)
        • ZALOPAY_APP_ID / KEY1 / KEY2
    end note

    note bottom of prod_db_node
        <b>Bảo mật Cơ sở dữ liệu:</b>
        • Cổng nội bộ: 5432 (Không mở Public IP)
        • Chỉ kết nối từ backend qua Private VPC
        • SSL/TLS bắt buộc (sslmode=require)
    end note
}

' ==============================================================================
' 5. DỊCH VỤ THANH TOÁN BÊN THỨ BA (EXTERNAL SERVICES)
' ==============================================================================
node "Dịch Vụ Bên Thứ Ba (Third-Party Services)\n<<cloud>>" as ext_services {
    node "Hạ Tầng Cổng Thanh Toán ZaloPay\n<<gateway: sb-openapi.zalopay.vn>>" as zalopay_cloud {
        component "ZaloPay Sandbox Gateway API v2\n[Create Order, Query Status, Webhook Callback]" as zalopay_api
    }
}

' ==============================================================================
' CÁC KẾT NỐI VÀ GIAO THỨC (PROTOCOLS & CONNECTIONS)
' ==============================================================================

' Kết nối Client -> Production Edge
spa_client -[#0D9488,bold]-> render_edge : "1. HTTPS :443 (TLS 1.3 / REST & Dynamic SSR)"

' Render Edge phân luồng
render_edge -[#0D9488]-> prod_web_app : "2a. Reverse Proxy\n(HTTP :3000)"
render_edge -[#0D9488]-> prod_api_app : "2b. Reverse Proxy / API calls\n(HTTP :3001)"

' Kết nối nội bộ Backend -> PostgreSQL
prod_api_app -[#B45309,bold]-> prod_db_node : "3. Private Network (TCP :5432)\nInternal VPC Connection (Prisma Connection Pool)"

' Kết nối Backend -> ZaloPay
prod_api_app -[#D97736,dashed]-> zalopay_api : "4. HTTPS :443\n(HMAC-SHA256 Authenticated REST API)"

' Luồng CI/CD
git_source -[#6366F1]-> gh_runner : "Push commit / PR\nTrigger Workflow"
gh_runner -[#6366F1]-> ghcr_registry : "Build & Push Multi-stage Image\n(TLS :443 via GHCR_PAT)"
gh_runner -[#6366F1,dashed]-> render_edge : "Deploy Hook Webhook Call\n(Trigger Auto-Deploy)"
ghcr_registry .[#6366F1].> prod_web_node : "Pull Image\n(ghcr.io/brewlite-web:sha)"
ghcr_registry .[#6366F1].> prod_api_node : "Pull Image\n(ghcr.io/brewlite-api:sha)"

' Kết nối Local Development
local_web -[#4B5563]-> local_api : "HTTP :3001 (API Proxy)"
local_api -[#4B5563]-> local_db : "TCP :5432 (Docker Network)"
spa_client .[#9CA3AF].> local_web : "Dev Test: http://localhost:3000"

@enduml
