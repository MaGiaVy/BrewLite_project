@startuml
skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam shadowing false
skinparam monochrome true
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle hline

skinparam activity {
    BorderColor black
    BackgroundColor white
    ArrowColor black
}
skinparam swimlane {
    BorderColor black
    TitleFontColor black
}

title SƠ ĐỒ HOẠT ĐỘNG (ACTIVITY DIAGRAM): DUYỆT THỰC ĐƠN & DANH MỤC SẢN PHẨM\n(Thiết kế tích hợp API NestJS GET /products)

|#White|Khách hàng|
|#White|Giao diện Next.js (Frontend)|
|#White|Hệ thống Backend (NestJS API)|

|Khách hàng|
start
:Truy cập trang Thực đơn (/menu);

|Giao diện Next.js (Frontend)|
:Hiển thị hiệu ứng Skeleton loader;
:Gửi yêu cầu GET /products;

|Hệ thống Backend (NestJS API)|
:Truy vấn danh mục sản phẩm đang kích hoạt;
:Trả về danh sách món cơ sở và định giá size, topping;

|Giao diện Next.js (Frontend)|
:Hiển thị danh sách card món theo phân loại tab;

|Khách hàng|
:Chọn xem 1 sản phẩm cụ thể;

|Giao diện Next.js (Frontend)|
if (Sản phẩm còn hàng trong kho?) then ([Hết hàng / Sold Out])
    :Hiển thị badge "Hết hàng";
    :Làm mờ và khóa nút chọn món;
    |Khách hàng|
    :Xem thông báo món tạm hết;
    :Dừng thao tác với món này;
    stop
else ([Còn hàng sẵn sàng])
    |Giao diện Next.js (Frontend)|
    :Mở chi tiết sản phẩm;
    |Khách hàng|
    :Xem thông tin chi tiết món;
    stop
endif

@enduml
