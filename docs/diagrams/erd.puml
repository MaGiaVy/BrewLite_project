@startuml erd
' ERD 12 bảng PostgreSQL — đồng bộ apps/api/prisma/schema.prisma
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
hide circle
title ERD CƠ SỞ DỮ LIỆU BREWLITE (12 BẢNG)

entity "User" as User {
  * id : int <<PK>>
  --
  * email : string <<UQ>>
  * passwordHash : string
  fullName : string
  phone : string
  position : string
  * isActive : boolean
  * role : Role
  * loyaltyPoints : int
  * tokenVersion : int
  * createdAt : datetime
}

entity "UserVoucher" as UserVoucher {
  * id : int <<PK>>
  --
  * userId : int <<FK>>
  * code : string
  * quantity : int
  * discountPercent : float
  * minOrderAmount : float
  maxDiscountAmount : float
  createdAt, updatedAt : datetime
  UQ(userId, code)
}

entity "DiscountCode" as DiscountCode {
  * id : int <<PK>>
  --
  * code : string <<UQ>>
  description : string
  * discountPercent : float
  * minOrderAmount : float
  maxDiscountAmount : float
  * isActive : boolean
  * usageCount : int
  createdAt, updatedAt : datetime
}

entity "Order" as Order {
  * id : int <<PK>>
  --
  userId : int <<FK>>
  * status : OrderStatus
  * totalAmount : float
  discountCode : string
  * discountAmount : float
  * voucherDeducted : boolean
  voucherDiscountPercent : float
  voucherMinOrderAmount : float
  voucherMaxDiscountAmount : float
  * version : int
  idempotencyKey : string
  idempotencyPayload : string
  staffId : int
  staffName : string
  createdAt, updatedAt : datetime
  UQ(userId, idempotencyKey)
}

entity "OrderItem" as OrderItem {
  * id : int <<PK>>
  --
  * orderId : int <<FK>>
  * productId : int
  * productName : string
  * size : string
  sugarLevel : string
  iceLevel : string
  temperature : string
  notes : string
  toppings : string[]
  * quantity : int
  * unitPrice : float
}

entity "Payment" as Payment {
  * id : int <<PK>>
  --
  * orderId : int <<FK>>
  idempotencyKey : string <<UQ>>
  * amount : float
  * method : PaymentMethod
  * status : PaymentStatus
  * createdAt : datetime
}

entity "Product" as Product {
  * id : int <<PK>>
  --
  * name : string
  description : string
  imageUrl : string
  * basePrice : float
  sizeUpchargeM : float
  sizeUpchargeL : float
  * category : string
  tag : string
  * isActive : boolean
  * isSoldOutManual : boolean
  createdAt, updatedAt : datetime
}

entity "Ingredient" as Ingredient {
  * id : int <<PK>>
  --
  * code : string <<UQ>>
  * name : string
  * unit : string
  * stock : float
  * minThreshold : float
  * costPerUnit : float
  * type : string
  * isRequiredForSale : boolean
  * version : int
  createdAt, updatedAt : datetime
}

entity "Recipe" as Recipe {
  * id : int <<PK>>
  --
  * productId : int <<FK>>
  * ingredientId : int <<FK>>
  * size : string
  * amount : float
  UQ(productId, ingredientId, size)
}

entity "ToppingRecipe" as ToppingRecipe {
  * id : int <<PK>>
  --
  * toppingId : string
  * toppingName : string
  subtext : string
  * price : float
  * isActive : boolean
  * ingredientId : int <<FK>>
  * amount : float
  UQ(toppingId, ingredientId)
}

entity "InventoryLog" as InventoryLog {
  * id : int <<PK>>
  --
  * ingredientId : int <<FK>>
  * ingredientName : string
  * unit : string
  * type : string
  * changeAmount : float
  * previousStock : float
  * newStock : float
  * unitCost : float
  * totalCost : float
  note : string
  performedBy : string
  * createdAt : datetime
}

entity "StoreSetting" as StoreSetting {
  * key : string <<PK>>
  --
  * value : string
  description : string
  updatedAt : datetime
}

User ||--o{ Order : "đặt (0..1 : N)"
User ||--o{ UserVoucher : "sở hữu (Cascade)"
Order ||--o{ OrderItem : "gồm (Cascade)"
Order ||--o{ Payment : "thanh toán"
Product ||--o{ Recipe : "định mức (Cascade)"
Ingredient ||--o{ Recipe : "dùng (Cascade)"
Ingredient ||--o{ ToppingRecipe : "dùng (Cascade)"
Ingredient ||--o{ InventoryLog : "nhật ký (Restrict)"

note bottom of StoreSetting
  Enum: Role {CUSTOMER, STAFF, ADMIN}
  OrderStatus {PENDING, PAID, PREPARING, READY, COMPLETED, PAYMENT_FAILED, CANCELLED}
  PaymentMethod {EWALLET, BANK_CARD}; PaymentStatus {SUCCESS, FAILED, PENDING}
  DiscountCode, StoreSetting: bảng độc lập (không FK)
end note
@enduml
