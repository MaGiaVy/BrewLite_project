@startuml erd
' ERD 12 bảng PostgreSQL — đồng bộ 100% apps/api/prisma/schema.prisma
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam nodesep 60
skinparam ranksep 60
hide circle

title ERD CƠ SỞ DỮ LIỆU BREWLITE (12 BẢNG — schema.prisma)

entity "User" as User {
  * id : int <<PK, autoincrement>>
  --
  * email : string <<UQ>>
  * passwordHash : string
  fullName : string?
  phone : string?
  position : string?
  * isActive : boolean = true
  * role : Role = CUSTOMER
  * loyaltyPoints : int = 0
  * tokenVersion : int = 0
  * createdAt : datetime
}

entity "UserVoucher" as UserVoucher {
  * id : int <<PK, autoincrement>>
  --
  * userId : int <<FK>>
  * code : string
  * quantity : int = 1
  * discountPercent : float
  * minOrderAmount : float = 0
  maxDiscountAmount : float?
  * createdAt : datetime
  * updatedAt : datetime
  --
  <<UQ(userId, code)>>
}

entity "DiscountCode" as DiscountCode {
  * id : int <<PK, autoincrement>>
  --
  * code : string <<UQ>>
  description : string?
  * discountPercent : float
  * minOrderAmount : float = 0
  maxDiscountAmount : float?
  * isActive : boolean = true
  * usageCount : int = 0
  * createdAt : datetime
  * updatedAt : datetime
}

entity "Order" as Order {
  * id : int <<PK, autoincrement>>
  --
  userId : int? <<FK>>
  * status : OrderStatus = PENDING
  * totalAmount : float
  discountCode : string?
  * discountAmount : float = 0
  * voucherDeducted : boolean = false
  voucherDiscountPercent : float?
  voucherMinOrderAmount : float?
  voucherMaxDiscountAmount : float?
  * version : int = 0
  idempotencyKey : string?
  idempotencyPayload : string?
  staffId : int?
  staffName : string?
  * createdAt : datetime
  * updatedAt : datetime
  --
  <<UQ(userId, idempotencyKey)>>
}

entity "OrderItem" as OrderItem {
  * id : int <<PK, autoincrement>>
  --
  * orderId : int <<FK>>
  * productId : int
  * productName : string
  * size : string
  sugarLevel : string? = "100%"
  iceLevel : string? = "100%"
  temperature : string? = "COLD"
  notes : string?
  * toppings : string[]
  * quantity : int
  * unitPrice : float
}

entity "Payment" as Payment {
  * id : int <<PK, autoincrement>>
  --
  * orderId : int <<FK>>
  idempotencyKey : string? <<UQ>>
  * amount : float
  * method : PaymentMethod
  * status : PaymentStatus
  * createdAt : datetime
}

entity "Product" as Product {
  * id : int <<PK, autoincrement>>
  --
  * name : string
  description : string?
  imageUrl : string?
  * basePrice : float
  sizeUpchargeM : float?
  sizeUpchargeL : float?
  * category : string = "vietnamese"
  tag : string? = "Phổ biến"
  * isActive : boolean = true
  * isSoldOutManual : boolean = false
  * createdAt : datetime
  * updatedAt : datetime
}

entity "Ingredient" as Ingredient {
  * id : int <<PK, autoincrement>>
  --
  * code : string <<UQ>>
  * name : string
  * unit : string
  * stock : float = 0
  * minThreshold : float = 100
  * costPerUnit : float = 0
  * type : string = "INGREDIENT"
  * isRequiredForSale : boolean = true
  * version : int = 0
  * createdAt : datetime
  * updatedAt : datetime
}

entity "Recipe" as Recipe {
  * id : int <<PK, autoincrement>>
  --
  * productId : int <<FK>>
  * ingredientId : int <<FK>>
  * size : string = "ALL"
  * amount : float
  --
  <<UQ(productId, ingredientId, size)>>
}

entity "ToppingRecipe" as ToppingRecipe {
  * id : int <<PK, autoincrement>>
  --
  * toppingId : string
  * toppingName : string
  subtext : string? = "Topping thơm ngon chuẩn vị"
  * price : float = 8000
  * isActive : boolean = true
  * ingredientId : int <<FK>>
  * amount : float
  --
  <<UQ(toppingId, ingredientId)>>
}

entity "InventoryLog" as InventoryLog {
  * id : int <<PK, autoincrement>>
  --
  * ingredientId : int <<FK>>
  * ingredientName : string
  * unit : string
  * type : string = "RESTOCK"
  * changeAmount : float
  * previousStock : float
  * newStock : float
  * unitCost : float = 0
  * totalCost : float = 0
  note : string?
  performedBy : string?
  * createdAt : datetime
}

entity "StoreSetting" as StoreSetting {
  * key : string <<PK>>
  --
  * value : string
  description : string?
  * updatedAt : datetime
}

User |o--o{ Order : "đặt (0..1 : N)"
User ||--o{ UserVoucher : "sở hữu (Cascade)"
Order ||--o{ OrderItem : "gồm (Cascade)"
Order ||--o{ Payment : "thanh toán (Restrict)"
Product ||--o{ Recipe : "định mức (Cascade)"
Ingredient ||--o{ Recipe : "dùng (Cascade)"
Ingredient ||--o{ ToppingRecipe : "dùng (Cascade)"
Ingredient ||--o{ InventoryLog : "nhật ký (Restrict)"
OrderItem ..> Product : "snapshot productId"

note bottom of StoreSetting
  Prisma Enums:
  • Role { CUSTOMER, STAFF, ADMIN }
  • OrderStatus { PENDING, PAID, PREPARING, READY, COMPLETED, PAYMENT_FAILED, CANCELLED }
  • PaymentMethod { EWALLET, BANK_CARD }
  • PaymentStatus { SUCCESS, FAILED, PENDING }
  • DiscountCode & StoreSetting: bảng cấu hình độc lập (không FK)
end note

@enduml
