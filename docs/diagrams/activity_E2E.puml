@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam ArrowColor #000000
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam ActivityDiamondFontSize 11
skinparam conditionStyle InsideDiamond
skinparam SwimlaneBorderColor #000000
skinparam SwimlaneTitleFontStyle bold
skinparam maxMessageSize 180

title Sơ đồ Hoạt động E2E: Chọn món -> Đặt hàng -> Thanh toán -> Pha chế (BrewLite)

|Khách hàng|
start
:Truy cập thực đơn (/menu);

|Web Next.js|
:Gọi GET /products &\nlọc 6 danh mục (Espresso,\nPhin, Trà, Cold Brew, Bánh);

|Khách hàng|
if (\n    Chọn món?    \n) then (Chi tiết)
  :Mở trang /products/[id]\nchọn Size / kiểu Bánh,\nNhiệt độ, Đường, Đá, Topping;
else (Nhanh)
  :Nhấn (+) chọn Size mặc định;
endif

|Web Next.js|
:Lưu giỏ Zustand (localStorage)\nlineId = productId-size-toppingIds\n(tối đa 20 ly/dòng);

|Khách hàng|
:Mở /cart, áp dụng Voucher\n& nhấn "Thanh toán";

|Web Next.js|
if (\n    Đã có JWT?    \n) then (Chưa)
  :Chuyển /auth/login?redirect=%2Fcheckout;
  stop
else (Có)
  :Mở /checkout (UI đếm 5p,\nTTL backend 15 phút);
endif

|Khách hàng|
:Chọn thanh toán &\nnhấn "Đặt hàng";

|Web Next.js|
:Phase 1: Gửi POST /orders\nkèm Idempotency-Key;

|NestJS API|
:Check JWT, Idempotency-Key,\nUser FOR UPDATE (< 5 đơn chờ),\ncheck Recipe bắt buộc (400 nếu thiếu),\ntính giá 0% VAT & check/trừ Voucher\n(mã công khai 1 lần/userId);

|PostgreSQL|
:Tính BOM (Recipe+Topping+Bao bì)\nTrừ kho Optimistic Lock\n(version+1, tối đa 3 lần thử)\n& ghi InventoryLog (SALE);

if (\n    Đủ kho?    \n) then (Lỗi 400/409)
  :Rollback Transaction;
  |NestJS API|
  :Trả 400 (Thiếu công thức / Hết hàng)\nhoặc 409 (Xung đột);
  |Web Next.js|
  :Báo lỗi chỉnh giỏ hàng;
  stop
else (Đủ)
  |PostgreSQL|
  :Tạo Order PENDING\n(hoặc PAID nếu 0đ)\nTTL 15 phút;
endif

|Web Next.js|
if (\n    Phương thức?    \n) then (ZaloPay)
  :Phase 2: POST /payments/zalopay/create\n-> chuyển /gateway/zalopay;
  |ZaloPay / Mock|
  :Xử lý Sandbox & gửi IPN\nPOST /payments/zalopay/callback\n(HMAC Key2) hoặc query status;
else (Mock)
  |Web Next.js|
  :Phase 2: Gửi POST /payments\nkèm Idempotency-Key;
  |ZaloPay / Mock|
  :Mô phỏng SUCCESS / FAILED;
endif

|NestJS API|
if (\n      Thanh toán      \n      thành công?      \n) then (Có)
  |PostgreSQL|
  :CAS Order -> PAID\n& tạo Payment (SUCCESS);
  |Web Next.js|
  :Xóa giỏ & mở /orders/:id\nPolling GET /orders/:id mỗi 5s\n(thanh tiến trình 3 bước);
else (Thất bại)
  |PostgreSQL|
  :Order -> PAYMENT_FAILED\n(giữ kho BOM 15p để thử lại);
  |Web Next.js|
  if (\n    Hành động?    \n  ) then (Thử lại)
    :Thanh toán lại\n(PAYMENT_FAILED -> PENDING);
    stop
  else (Hủy / Quá 15p)
    |NestJS API|
    :Hủy đơn (PATCH /status hoặc\nDELETE chủ đơn/ADMIN)\nhoặc ExpireOrdersJob (sau 15p TTL);
    |PostgreSQL|
    :Order -> CANCELLED,\nhoàn kho BOM & Voucher;
    stop
  endif
endif

|Nhân viên KDS|
:Màn hình /staff polling\nGET /orders/barista/queue mỗi 3s;
if (\n      Hủy đơn PAID      \n      trước pha?      \n) then (Hủy)
  :Staff / Admin hủy PAID -> CANCELLED\nqua PATCH /orders/:id/status\n(chỉ hoàn BOM & Voucher);
  stop
else (Pha chế)
  :Bấm "Bắt đầu pha" (PAID -> PREPARING);
  :Bấm "Báo đã xong" (PREPARING -> READY);
  :Bấm "Giao khách" (READY -> COMPLETED);
  |PostgreSQL|
  :Order -> COMPLETED &\ncộng loyaltyPoints\n(+floor(total / 1.000đ));
endif

|Khách hàng|
:Nhận đồ uống & kết thúc;
stop

@enduml
