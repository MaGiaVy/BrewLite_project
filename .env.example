# Copy file này thành `.env` và thay các giá trị. KHÔNG commit `.env`.
# Toàn bộ giá trị dưới đây chỉ là ví dụ cho môi trường local/Docker, không phải secret thật.

# ---------- PostgreSQL (docker-compose service `db`) ----------
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite
DB_PORT=5432

# ---------- API (apps/api) ----------
# Chạy local (ngoài Docker): trỏ tới DB đã publish ở DB_PORT.
# Trong Docker Compose, DATABASE_URL được compose tự ghép từ các biến POSTGRES_*.
DATABASE_URL=postgresql://brewlite:brewlite_password@localhost:5432/brewlite?schema=public
# Bắt buộc thay bằng chuỗi ngẫu nhiên >= 32 ký tự khi chạy production / docker compose
JWT_SECRET=replace-with-a-random-32-plus-char-secret-key
JWT_EXPIRES_IN=7d
# success | failure
MOCK_PAYMENT_MODE=success
ALLOW_MOCK_PAYMENT=true
ALLOW_SANDBOX_CONFIRM=false
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
API_PORT=3001

# ---------- ZaloPay Payment Gateway (Optional in Mock Mode, Required for Live Sandbox) ----------
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=http://localhost:3001/payments/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:3000

# ---------- Web (apps/web) ----------
# Giá trị này được nhúng lúc build (NEXT_PUBLIC_*), trình duyệt phải truy cập được.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENABLE_DEMO_TOOLS=false
WEB_PORT=3000
