# ---------- PostgreSQL (docker-compose service `db`) ----------
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite
DB_PORT=5432

# ---------- API (apps/api) ----------
DATABASE_URL=postgresql://brewlite:brewlite_password@localhost:5432/brewlite?schema=public
JWT_SECRET=brewlite-super-secret-jwt-key-2026-sgu
JWT_EXPIRES_IN=7d
MOCK_PAYMENT_MODE=success
ALLOW_SANDBOX_CONFIRM=false
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
API_PORT=3001

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000

