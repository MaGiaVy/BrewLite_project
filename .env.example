# Copy file này thành `.env` và thay các giá trị. KHÔNG commit `.env`.
# Toàn bộ giá trị dưới đây chỉ là ví dụ cho môi trường local/Docker, không phải secret thật.

# ---------- PostgreSQL (docker-compose service `db`) ----------
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=brewlite
DB_PORT=5433

# ---------- API (apps/api) ----------
# Chạy local (ngoài Docker): trỏ tới DB đã publish ở DB_PORT.
# Trong Docker Compose, DATABASE_URL được compose tự ghép từ các biến POSTGRES_*.
DATABASE_URL=postgresql://brewlite:change-me-db-password@localhost:5433/brewlite?schema=public
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=7d
# success | failure
MOCK_PAYMENT_MODE=success
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
API_PORT=3001

# ---------- Web (apps/web) ----------
# Giá trị này được nhúng lúc build (NEXT_PUBLIC_*), trình duyệt phải truy cập được.
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000
