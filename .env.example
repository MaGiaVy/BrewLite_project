# BrewLite Environment Configuration
# Copy this file to .env and customize values as needed.
# Default values are provided so the project runs out-of-the-box for grading.

# PostgreSQL Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=brewlite

# Backend
DATABASE_URL=postgresql://user:password@postgres:5432/brewlite?schema=public
JWT_SECRET=brewlite_super_secret_jwt_key_2026_sgu
